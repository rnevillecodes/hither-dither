{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HitherDither",
  "version": "0.2.1",
  "identifier": "io.github.rnevillecodes.hitherdither",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HitherDither",
        "theme": "Dark",
        "width": 1200,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "maximized": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
